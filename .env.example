# ===========================================
# ResumeSense Environment Variables
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit the actual .env file

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://resumesense:resumesense@localhost:5432/resumesense
DB_NAME=resumesense
DB_USER=resumesense
DB_PASSWORD=resumesense
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=media/

# Frontend
VITE_API_URL=http://localhost:8000/api

# Docker Postgres
POSTGRES_DB=resumesense
POSTGRES_USER=resumesense
POSTGRES_PASSWORD=resumesense
