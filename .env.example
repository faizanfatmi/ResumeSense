# ============================================================
# ResumeSense — environment variables (single-service deploy)
# ============================================================
# The React frontend is built into and served by the Django backend, so one
# set of variables configures the whole app.
# Copy to .env and fill in values:  cp .env.example .env
# NEVER commit the real .env file.
#
# Note: the frontend calls the API on the SAME origin (relative "/api"), so no
# VITE_API_URL is required. Only set it if you later split the two apps apart.

# --- Django core ---
# Generate a strong value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
# Comma-separated. On Render use: .onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Option A: a single connection string (this wins if set). Render provides one.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
# Option B: discrete settings (used when DATABASE_URL is empty).
# Leave DB_NAME empty to fall back to a local SQLite file (dev only).
DB_NAME=resumesense
DB_USER=resumesense
DB_PASSWORD=resumesense
DB_HOST=localhost
DB_PORT=5432

# --- CSRF (needed for the Django admin behind an HTTPS proxy) ---
# Comma-separated, scheme required. On Render: https://*.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- CORS (only needed if the frontend is ever hosted on a DIFFERENT origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEXES=

# --- JWT ---
# Defaults to SECRET_KEY if left blank.
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=media/
