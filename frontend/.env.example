# ============================================================
# ResumeSense — Frontend (Vite / React) environment variables
# ============================================================
# Copy to frontend/.env for local development:  cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# and they are baked in at BUILD time (not read at runtime).
# NEVER commit the real .env file.

# Base URL the SPA uses to reach the backend API.
#
# Local dev / docker-compose:
#   Leave this UNSET (or blank). The app then uses the relative path "/api",
#   which the Vite dev server (see vite.config.ts) and the nginx container
#   proxy to the Django backend on the same origin.
#
# Render (frontend static site + separate backend web service):
#   Set this to the backend service's public URL + "/api", e.g.
#   VITE_API_URL=https://resumesense-backend.onrender.com/api
#   (Then add that static site's URL to the backend's CORS settings.)
VITE_API_URL=
