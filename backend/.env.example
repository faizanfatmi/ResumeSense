# ============================================================
# ResumeSense — Backend (Django) environment variables
# ============================================================
# Copy to backend/.env for local development:  cp .env.example .env
# On Render these are set as service env vars (see ../render.yaml).
# NEVER commit the real .env file.

# --- Django core ---
# Generate a strong value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
# Comma-separated. On Render use: .onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Option A: a single connection string (this wins if set). Render provides one.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
# Option B: discrete settings (used when DATABASE_URL is empty).
# Leave DB_NAME empty to fall back to a local SQLite file (dev only).
DB_NAME=resumesense
DB_USER=resumesense
DB_PASSWORD=resumesense
DB_HOST=localhost
DB_PORT=5432

# --- CORS (which frontend origins may call the API) ---
# Exact origins, comma-separated (used in local dev):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex origins, comma-separated (handy on Render so you don't need
# to know the exact static-site URL). Example matches any Render subdomain:
#   ^https://.*\.onrender\.com$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- CSRF (only needed for the Django admin behind an HTTPS proxy) ---
# Comma-separated, scheme required. On Render: https://*.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- JWT ---
# Defaults to SECRET_KEY if left blank.
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10
# Where uploaded files are stored on disk (relative to the backend app root).
MEDIA_ROOT=media/
